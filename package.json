{
  "name": "dsh-subscriptions-enhanced",
  "version": "0.3.10",
  "private": true,
  "type": "module",
  "description": "Manage DSH subscriptions and work with Gemini through the local official Antigravity CLI.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Leo19990721/dsh-plugin-subscriptions-enhanced.git" },
  "homepage": "https://github.com/Leo19990721/dsh-plugin-subscriptions-enhanced#readme",
  "bugs": { "url": "https://github.com/Leo19990721/dsh-plugin-subscriptions-enhanced/issues" },
  "engines": { "node": ">=24.0.0" },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/writing-*.js", "lib/agy-local-*.js", "lib/agy-ingress.js", "lib/agy-identity.js", "lib/agy-launch.js", "lib/agy-acp-client.js", "lib/agy-session.js", "lib/agy-turn-session.js", "lib/agy-turn-options.js", "lib/upstream.json", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE", "LICENSE-DSH", "NOTICE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-model-selection"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:portable": "node scripts/test.mjs --portable",
    "release:pack": "pwsh -NoProfile -File scripts/pack.ps1",
    "check": "node scripts/check.mjs"
  },
  "dependencies": { "undici": "7.30.2" },
  "devDependencies": { "dsh-plugin-subscriptions": "*" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-home-paths": { "optional": true },
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-web": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  }
}
