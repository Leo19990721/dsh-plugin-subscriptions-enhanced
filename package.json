{
  "name": "dsh-plugin-subscriptions-enhanced",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "Manage Codex and Gemini subscriptions in native DSH Model Settings while retaining Gemini writing mode.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Leo19990721/dsh-plugin-subscriptions-enhanced.git" },
  "homepage": "https://github.com/Leo19990721/dsh-plugin-subscriptions-enhanced#readme",
  "bugs": { "url": "https://github.com/Leo19990721/dsh-plugin-subscriptions-enhanced/issues" },
  "engines": { "dsh": ">=0.2.2-rc.3 <0.3.0-0", "node": ">=24.0.0" },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib/*.js", "lib/upstream.json", "cordis.patch.yml", "locale", "icon.svg", "README.md", "LICENSE", "LICENSE-DSH", "NOTICE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-model-selection"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:portable": "node scripts/test.mjs --portable",
    "release:pack": "pwsh -NoProfile -File scripts/pack.ps1",
    "check": "node --check src/policy.js && node --check src/gemini-prompt.js && node --check src/badge-compat.js && node --check src/models-settings-ui.js && node --check scripts/models-settings-patch.mjs && node --check src/writing-policy.js && node --check src/writing-host.js && node --check lib/index.js && node --check lib/client.js"
  },
  "dependencies": { "undici": "7.30.2" },
  "devDependencies": { "dsh-plugin-subscriptions": "0.9.13" },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <4.2.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <4",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-home-paths": { "optional": true },
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-web": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  }
}
