+  ModelProviderGroup, PromptContentPart, SessionModelCatalogRequest,
+  SessionPromptRequest, SessionRequestId, SessionSelectModelRequest, SessionUpdateQueueRequest,
+} from '../src/types.ts'
+import { createSessionTurnHost, sessionTurnModels } from './session-turn-provider-fixture.ts'
+
+// A granted Remote caller still needs the turn provider's local authority.
+declare module '@deepseek-ai/dsh-typert-protocol' {
+  interface PrincipalMap {
+    'fixture-remote': { readonly kind: 'fixture-remote' }
+  }
+}
+
+const SESSION = SessionId('turn-provider-session')
+const { ordinary: ORDINARY, next: NEXT } = sessionTurnModels
+const EXTERNAL = { provider: 'turn:fixture', model: 'fixture' } as const
+const GROUP = {
+  id: EXTERNAL.provider, name: 'Fixture', models: [{ id: EXTERNAL.model, name: 'Fixture turn' }], input: 'text-only',
+} as const satisfies ModelProviderGroup
+const ACCEPTED = { accepted: true }
+const UNAVAILABLE = { code: 'session/agent-busy', details: { reason: 'LOCAL_TURN_UNAVAILABLE' } }
+const STALE = { code: 'session/agent-busy', details: { reason: 'MODEL_SELECTION_CHANGED' } }
+const TEXT_ONLY = { code: 'session/attachment-invalid', details: { reason: 'TEXT_ONLY_SELECTION' } }
+
+const text = (value: string) => [{ type: 'text', text: value }] as const
+
+async function setup() {
+  const unblock: (() => void)[] = []
+  const { ctx, root, adapter } = await createSessionTurnHost({
+    ordinaryResponses: ['ordinary reply', 'ordinary reply'],
+    beforeDispose: () => { for (const release of unblock) release() },
+  })
+
+  const browser = ctx.connection.browserPeer
+  const remoteOwner = ctx.connection.createPeer({ principal: { kind: 'owner' }, interactions: 'none' })
+  const remote = ctx.connection.createPeer({ principal: { kind: 'fixture-remote' }, interactions: 'none' })
+  ctx.remoteAccess.registerPolicy('fixture-remote', {
+    bindings: () => [{
+      role: {
+        name: 'fixture-session-operator', resource: 'session',
+        actions: ['session/modelCatalog', 'session/selectModel', 'session/prompt', 'session/updateQueue', 'session/cancel'],
+      },
+      resource: { kind: 'session', id: SESSION },
+    }],
+  })
+  const invoke = (method: string, args: Readonly<Record<string, unknown>>, peer = browser) =>
+    ctx.typertGateway.invoke({ peer, namespace: 'session', method, args })
+  const create = async (sessionId: SessionId): Promise<Agent> => {
+    await expect(invoke('create', { request: { sessionId, cwd: root } })).resolves.toMatchObject({ sessionId })
+    const agent = ctx.agents.get(sessionId)
+    if (agent === undefined) throw new Error(`Session creation did not publish Agent ${sessionId}`)
+    return agent
+  }
+  const agent = await create(SESSION)
+  const conversation: SessionModelCatalogRequest = { audience: 'conversation', sessionId: agent.id }
+  const select = (selection: Omit<SessionSelectModelRequest, 'sessionId'>, peer = browser, sessionId = agent.id) =>
+    invoke('selectModel', { request: { ...selection, sessionId } satisfies SessionSelectModelRequest }, peer)
+  const prompt = (
+    id: string,
+    content: readonly PromptContentPart[],
+    options: Partial<Pick<SessionPromptRequest, 'mode' | 'expectedSelection' | 'serializedReferences'>> = {},
+    peer = browser,
+  ) =>
+    invoke('prompt', { request: {
+      sessionId: agent.id, requestId: brandString<SessionRequestId>(id), mode: 'queue', content,
+      ...(agent.model.current()?.provider === EXTERNAL.provider ? { expectedSelection: EXTERNAL } : {}), ...options,
+    } satisfies SessionPromptRequest }, peer)
+  const update = (itemId: SessionUpdateQueueRequest['itemId'], action: SessionUpdateQueueRequest['action'], peer = browser) =>
+    invoke('updateQueue', { request: { sessionId: agent.id, itemId, action } satisfies SessionUpdateQueueRequest }, peer)
+  const stored = async (): Promise<readonly SessionEvent[]> => {
+    await using reader = await ctx.sessionPersistence.open(agent.id, 'read')
+    return (await reader.read()).events
+  }
+
+  function gate<T>() {
+    const entered = Promise.withResolvers<T>()
+    const proceed = Promise.withResolvers<undefined>()
+    const release = () => { proceed.resolve(undefined) }
+    unblock.push(release)
+    return {
+      entered: entered.promise, release,
+      async hold(value: T, signal?: AbortSignal): Promise<void> {
+        entered.resolve(value)
+        if (signal?.aborted === true) return
+        signal?.addEventListener('abort', release, { once: true })
+        try { await proceed.promise } finally { signal?.removeEventListener('abort', release) }
+      },
+    }
+  }
+
+  return {
+    ctx, agent, adapter, create, gate, prompt, remote, remoteOwner, select, stored, update,
+    catalog: (request?: SessionModelCatalogRequest, peer = browser) =>
+      invoke('modelCatalog', request === undefined ? {} : { request }, peer),
+    cancel: (peer = browser) => invoke('cancel', { request: { sessionId: agent.id } }, peer),
+    conversation,
+    browserId: browser.id,
+  }
+}
+
+async function beforeIdle<T>(agent: Agent, entered: Promise<T>): Promise<T> {
+  return Promise.race([entered, agent.whenIdle().then(() => {
+    throw new Error('The Agent settled before reaching the turn barrier')
+  })])
+}
+
+async function mountProvider(h: Awaited<ReturnType<typeof setup>>, hold?: (input: TurnExecution) => Promise<void>) {
+  let stamp: { agent: Agent; selection: ModelSelection; message: UserMessage; previous: UserMessage | undefined } | undefined
+  const local = (agent: Agent, invocation: RemoteInvocation | undefined): boolean => agent === h.agent
+    && invocation?.peer.id === h.browserId && invocation.peer.principal.kind === 'owner'
+  const runs: { input: TurnExecution; beforeDispatch: readonly SessionEvent[] }[] = []
+  const fiber = await h.ctx.plugin({
+    name: 'session-turn-fixture',
+    inject: ['agentLoop', 'sessionController'],
+    apply(owner: Context) {
+      owner.agentLoop.registerTurnExecutor(EXTERNAL.provider, {
+        authorize({ phase, agent, selection, message, previous }) {
+          // Native admission clones the offered message; check its full JSON, including id and source.
+          return phase === 'claim' || (stamp?.agent === agent && previous === stamp.previous
+            && isDeepStrictEqual(selection, stamp.selection) && isDeepStrictEqual(message, stamp.message))
+        },
+        async run(input) {
+          const beforeDispatch = await h.stored()
+          input.assertDispatchable()
+          runs.push({ input, beforeDispatch })
+          await hold?.(input)
+          if (input.signal.aborted) return { kind: 'cancelled' }
+          input.writeText('external reply')
+          return { kind: 'completed' }
+        },
+      } satisfies TurnExecutor)
+      owner.sessionController.registerTurnProvider(EXTERNAL.provider, {
+        catalog(agent, invocation) { return local(agent, invocation) ? GROUP : undefined },
+        select(agent, selection, invocation) {
+          return local(agent, invocation) && isDeepStrictEqual(selection, EXTERNAL)
+        },
+        withInput(agent, selection, message, invocation, accept, previous) {
+          if (!local(agent, invocation)) {
+            throw new RemoteError('session/agent-busy', 'The fixture requires the local peer', UNAVAILABLE.details)
+          }
+          if (stamp !== undefined) throw new Error('The fixture does not admit reentrant input')
+          stamp = { agent, selection, message, previous }
+          try { accept() } finally { stamp = undefined }
+        },
+        control(agent, _action, invocation) { return local(agent, invocation) },
+      })
+    },
+  })
+  return { fiber, runs }
+}
+
+it('carries the authorized caller through Connection to the stock Gateway without a listener', async () => {
+  const { ctx, http } = await createSessionTurnHost({ http: true })
+  const request = { type: 'client-request', rpcId: 'fixture-cookie-check', method: 'session/modelCatalog', payload: { args: {} } }
+  const body = vi.fn(() => JSON.stringify(request))
+  await expect(http.request('POST', '/api/session/modelCatalog', {
+    headers: { 'content-type': 'application/json' }, body,
+  })).resolves.toMatchObject({ status: 401 })
+  expect(body).not.toHaveBeenCalled()
+
+  const peers: boolean[] = []
+  ctx.on('connection/request', async (incoming, _outgoing, next) => {
+    const admission = ctx.connection.admit(incoming)
