+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId, type Session } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SessionTitleService, {
+  SessionTitleProviderId, type SessionTitleProviderRequest, type SessionTitleProviderResult,
+} from '@deepseek-ai/dsh-session-title'
+import { expect, it, onTestFinished, vi } from 'vitest'
+
+const ORDINARY = { provider: 'ordinary', model: 'main-model' }
+const EXTERNAL = { provider: 'turn:fixture', model: 'external-model' }
+const LOCAL_TITLE = 'External prompt stays local'
+const GENERATED_TITLE = 'Ordinary generated title'
+
+async function setup(): Promise<Context> {
+  const ctx = new Context()
+  onTestFinished(() => ctx.fiber.dispose())
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(SessionTitleService, { fallbackMaxWords: 8, fallbackMaxBytes: 64, maxTitleBytes: 80 })
+  return ctx
+}
+
+function appendPrompt(session: Session, text: string) {
+  return session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text }], source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+}
+
+function completeTurn(session: Session, turn: number, text: string, header = false) {
+  session.append('turn/start', { turn })
+  const message = appendPrompt(session, text)
+  if (header) session.append('request/header', { header: { config: ORDINARY }, reason: 'initial' })
+  session.append('turn/end', { turn, reason: { kind: 'completed' } })
+  return message
+}
+
+it.each(['first-prompt', 'all-prompts'] as const)(
+  'keeps the fallback local for %s title providers after changing back to an ordinary model',
+  async (automatic) => {
+    const ctx = await setup()
+    const external = ctx.sessions.create(SessionId('external-turn'))
+    const ordinary = ctx.sessions.create(SessionId('ordinary-only'))
+    const fallbackAccepted = Promise.withResolvers<undefined>()
+    const ordinaryGenerated = Promise.withResolvers<undefined>()
+    ctx.on('session/event', (session, event) => {
+      if (event.type !== 'session/title') return
+      if (session === external && event.data.source.kind === 'fallback') fallbackAccepted.resolve(undefined)
+      if (session === ordinary && event.data.source.kind === 'provider') ordinaryGenerated.resolve(undefined)
+    })
+    const generate = vi.fn((request: SessionTitleProviderRequest): Promise<SessionTitleProviderResult> => Promise.resolve({
+      title: GENERATED_TITLE, messageSeqs: request.messages.map(message => message.seq),
+    }))
+    ctx.sessionTitle.register({ id: SessionTitleProviderId('fixture'), automatic, generate })
+
+    external.append('model/selection', EXTERNAL)
+    const message = completeTurn(external, 1, LOCAL_TITLE)
+    await fallbackAccepted.promise
+    external.append('model/selection', ORDINARY)
+    completeTurn(external, 2, 'Continue on the ordinary route', true)
+    const ordinaryMessage = completeTurn(ordinary, 1, 'Ordinary prompt', true)
+    await ordinaryGenerated.promise
+    expect(generate.mock.calls.map(([request]) => ({
+      sessionId: request.session.id, messages: request.messages, currentTitle: request.currentTitle?.title,
+    }))).toEqual([{
+      sessionId: ordinary.id, messages: [{ seq: ordinaryMessage.seq, text: 'Ordinary prompt' }], currentTitle: 'Ordinary prompt',
+    }])
+
+    const opened = ctx.sessions.create(SessionId('replayed-turn'), { seed: external.snapshotEvents() })
+    const fork = ctx.sessions.fork(external, undefined, SessionId('forked-turn'))
+    for (const session of [external, opened, fork]) {
+      expect(ctx.sessionProjections.snapshot(session).values.title).toBe(LOCAL_TITLE)
+      ctx.sessionTitle.rename(session, 'Pinned')
+      await expect(ctx.sessionTitle.refresh(session)).resolves.toMatchObject({
+        title: LOCAL_TITLE, source: { kind: 'fallback' }, messageSeqs: [message.seq],
+      })
+    }
+    expect(generate).toHaveBeenCalledOnce()
+  },
+)
+
+it('cancels an in-flight provider as soon as a whole-turn route is selected', async () => {
+  const ctx = await setup()
+  const session = ctx.sessions.create(SessionId('switch-during-title'))
+  const message = completeTurn(session, 1, 'Ordinary input')
+  const entered = Promise.withResolvers<SessionTitleProviderRequest>()
+  const result = Promise.withResolvers<SessionTitleProviderResult>()
+  ctx.sessionTitle.register({
+    id: SessionTitleProviderId('held-provider'), automatic: 'first-prompt',
+    generate(request) { entered.resolve(request); return result.promise },
+  })
+  const refresh = ctx.sessionTitle.refresh(session)
+  const outcome = refresh.then(() => undefined, (error: unknown) => error)
+  const proposal = { title: 'Obsolete title', messageSeqs: [message.seq] }
+  try {
+    const request = await entered.promise
+    session.append('model/selection', EXTERNAL)
+    expect(request.signal.aborted).toBe(true)
+    result.resolve(proposal)
+    expect(await outcome).toMatchObject({ message: 'whole-turn provider selection requires local titles' })
+    expect(ctx.sessionTitle.get(session)).toMatchObject({ title: 'Ordinary input', source: { kind: 'fallback' } })
+  } finally {
+    result.resolve(proposal)
+  }
+})
