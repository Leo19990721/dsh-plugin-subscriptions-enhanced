+  request.method = method
+  request.httpVersion = '1.1'
+  request.httpVersionMajor = 1
+  request.httpVersionMinor = 1
+  request.headers = { host: new URL(origin).host, ...Object.fromEntries(new Headers(options.headers)) }
+  request.complete = true
+  const body = options.body
+  if (typeof body === 'function') {
+    request._read = () => {
+      try {
+        request.push(Buffer.from(body()))
+        request.push(null)
+      } catch (error) {
+        request.destroy(error instanceof Error ? error : new Error('Fixture HTTP body producer failed', { cause: error }))
+      }
+    }
+  } else {
+    if (body !== undefined) request.push(Buffer.from(body))
+    request.push(null)
+  }
+
+  const chunks: Buffer[] = []
+  const response = new ServerResponse(request)
+  // Using the public header table first makes writeHead retain its final headers.
+  response.setHeader('x-fixture', '')
+  const end = response.end.bind(response)
+  response.write = (chunk: string | Uint8Array) => {
+    chunks.push(Buffer.from(chunk))
+    return true
+  }
+  response.end = (chunk?: string | Uint8Array | (() => void)) => {
+    if (typeof chunk === 'string' || chunk instanceof Uint8Array) chunks.push(Buffer.from(chunk))
+    return end(typeof chunk === 'function' ? chunk : undefined)
+  }
+  try {
+    await handler(request, response)
+    if (!response.writableEnded) throw new Error(`Fixture HTTP handler did not end ${method} ${path}`)
+    const headers = new Headers()
+    for (const [name, value] of Object.entries(response.getHeaders())) {
+      if (name === 'x-fixture' || value === undefined) continue
+      if (Array.isArray(value)) for (const item of value) headers.append(name, item)
+      else headers.set(name, String(value))
+    }
+    return { status: response.statusCode, headers, body: Buffer.concat(chunks).toString('utf8') }
+  } finally {
+    request.destroy()
+    response.destroy()
+    socket.destroy()
+  }
+}
+
+function inProcessHttp(ctx: Context) {
+  const origin = 'http://127.0.0.1'
+  const routes = new Map<string, WebRoute | WebResourceRoute>()
+  const upgrades = new Map<string, WebUpgradeRoute>()
+  const server: Pick<WebServer, 'host' | 'port' | 'protocol' | 'register' | 'registerUpgrade' | 'getOrigin'> = {
+    host: '127.0.0.1', port: undefined, protocol: 'http:', getOrigin: () => origin,
+    register(route) {
+      const key = `${route.kind}:${route.path}`
+      if (routes.has(key)) throw new Error(`Duplicate fixture route ${key}`)
+      routes.set(key, route)
+      return () => { routes.delete(key) }
+    },
+    registerUpgrade(route) {
+      if (upgrades.has(route.path)) throw new Error(`Duplicate fixture upgrade ${route.path}`)
+      upgrades.set(route.path, route)
+      return () => { upgrades.delete(route.path) }
+    },
+  }
+  const plugin: SessionTurnHostPlugin = {
+    id: 'inProcessHttp', plugin: (owner) => { owner.provide('webServer', server as WebServer) },
+  }
+  const request: SessionTurnHttp['request'] = async (method, path, options = {}) => {
+    const { pathname } = new URL(path, origin)
+    const route = routes.get(`exact:${pathname}`) ?? [...routes.values()]
+      .filter(entry => entry.kind === 'prefix' && (pathname === entry.path || pathname.startsWith(`${entry.path}/`)))
+      .sort((a, b) => b.path.length - a.path.length)[0]
+    if (route === undefined) return { status: 404, headers: new Headers(), body: 'not found' }
+    if (!('handler' in route)) throw new Error('The fixture dispatches HTTP handlers only')
+    return captureHttp(origin, method, path, options, route.handler)
+  }
+  let nextRpcId = 0
+  const http: SessionTurnHttp = {
+    origin,
+    request,
+    async cookie(kind = 'browser') {
+      const url = new URL(ctx.connection.authenticatedUrl(`${origin}${kind === 'browser' ? '/' : '/connect'}`))
+      const path = `${url.pathname}${url.search}`
+      const exchanged = kind === 'operator'
+        ? await request('GET', path)
+        : await captureHttp(origin, 'GET', path, {}, (incoming, outgoing) => {
+          ctx.connection.authorizeIndex(incoming, outgoing)
+        })
+      const cookie = exchanged.headers.get('set-cookie')?.split(';', 1)[0]
+      if (exchanged.status !== (kind === 'browser' ? 303 : 302) || cookie === undefined) {
+        throw new Error(`Fixture ${kind} cookie exchange failed with status ${exchanged.status}`)
+      }
+      return cookie
+    },
+    async rpc(endpoint, args, options = {}) {
+      const rpcId = Connection.RpcId(`fixture-${++nextRpcId}`)
+      const result = await request('POST', `/api/${endpoint}`, {
+        ...options,
+        headers: { 'content-type': 'application/json', ...options.headers },
+        body: JSON.stringify({ type: 'client-request', method: endpoint, rpcId, payload: { args } } satisfies Connection.ClientRequest),
+      })
+      if (result.status !== 200) throw new Error(`Fixture RPC ${endpoint} returned HTTP ${result.status}`)
+      const reply = Connection.serverResponseSchema.parse(JSON.parse(result.body))
+      if (reply.rpcId !== rpcId) throw new Error(`Fixture RPC ${endpoint} did not echo the correlation id`)
+      return reply.result
+    },
+  }
+  return { plugin, http }
+}
+
+/**
+ * Load the stock Host services over a private temporary directory; no server listens.
+ * @param options - optional test builtins and the in-process HTTP handler adapter.
+ * @returns the active Context, its private root, and the scripted ordinary adapter.
+ */
+export function createSessionTurnHost(
+  options: SessionTurnHostOptions & { readonly http: true },
+): Promise<SessionTurnHostBase & { readonly http: SessionTurnHttp }>
+export function createSessionTurnHost(options?: SessionTurnHostOptions): Promise<SessionTurnHostBase & { readonly http?: SessionTurnHttp }>
+export async function createSessionTurnHost(
+  options: SessionTurnHostOptions = {},
+): Promise<SessionTurnHostBase & { readonly http?: SessionTurnHttp }> {
+  const temporary = await mkdtemp(join(tmpdir(), 'dsh-session-turn-provider-'))
+  const ctx = new Context()
+  onTestFinished(async () => {
+    try {
+      try { options.beforeDispose?.() } finally { await ctx.fiber.dispose() }
+    } finally {
+      await rm(temporary, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 })
+    }
+  })
+  const root = await realpath(temporary)
+  const ingress = options.http === true ? inProcessHttp(ctx) : undefined
+  const adapter = new CatalogAdapter((options.ordinaryResponses ?? ['ordinary reply']).map(textResponse))
+  const ordinaryAdapter = {
+    inject: ['llm'],
+    apply(owner: Context): void { owner.llm.registerAdapter([sessionTurnModels.ordinary.provider], adapter) },
+  }
+  const plugins: Readonly<Record<string, readonly [Plugin, object]>> = {
+    llm: [LlmRuntime, {}],
+    adapter: [ordinaryAdapter, {}],
+    sessions: [SessionStore, {}],
+    projections: [SessionProjectionRegistry, {}],
+    persistence: [JsonlSessionPersistence, { root: join(root, 'sessions'), compression: 'none' }],
+    query: options.search === true ? [SqliteSessionQueryEngine, { path: ':memory:' }] : [PointReads, {}],
+    storage: [Storage, {}],
+    jsonStorage: [StorageJson, { root: join(root, 'storage') }],
+    domains: [StorageDomain, { backend: 'json' }],
+    workspaces: [WorkspaceRegistry, {}],
+    fs: [LocalFileSystem, {}],
+    cwd: [WorkingDirectory, { defaultDirectory: root }],
+    fileReferences: [LocalFileReferences, {}],
+    prompt: [SystemPrompt, {}],
+    tools: [Tools, {}],
+    nativeTools: [NativeToolExecutor, {}],
+    agents: [AgentRegistry, {}],
+    agentLoop: [AgentLoop, { agents: [] }],
+    defaultModel: [AgentDefaultModel, sessionTurnModels.ordinary],
+    credentials: [MemoryCredentials, {}],
+    connection: [Connection, {}],
+    attachments: [LocalAttachmentStore, { dshHome: root }],
+    commands: [CommandRuntime, {}],
+    uploads: [FileUploads, {}],
+    typert: [TypertRegistry, {}],
+    remoteAccess: [RemoteAccess, {}],
+    gateway: [TypertGateway, {}],
+    sessionController: [SessionController, { nativeOpen: false }],
+  } as const
+  await ctx.plugin(Loader)
+  ctx.loader.builtins.include = Include
+  const rows: SessionTurnHostPlugin[] = Object.entries(plugins).map(([id, [plugin, config]]) => ({ id, plugin, config }))
+  if (ingress !== undefined) rows.push(ingress.plugin)
+  rows.push(...options.extras ?? [])
+  const path = join(root, 'cordis.yml')
+  const config = rows.map(({ id, plugin, config = {} }) => {
+    if (Object.hasOwn(ctx.loader.builtins, id)) throw new Error(`Duplicate fixture builtin ${id}`)
+    ctx.loader.builtins[id] = plugin
+    return { id, name: `cordis:${id}`, config }
+  })
+  await writeFile(path, `${JSON.stringify(config, null, 2)}\n`, { flag: 'wx' })
+  await ctx.loader.create({ name: 'cordis:include', config: { path: pathToFileURL(path).href } })
+  await ctx.loader.await()
+  const inactive = [...ctx.loader.entries()].filter(entry => entry.fiber?.state !== FiberState.ACTIVE)
+  expect(inactive.map(entry => entry.options.id)).toEqual([])
+  expect(ctx.get('webServer')?.port).toBeUndefined()
+  return { ctx, root, adapter, ...ingress === undefined ? {} : { http: ingress.http } }
+}
