+/** Registered Web admission for Session-local whole-turn routes. */
+import type { Agent, ModelSelection } from '@deepseek-ai/dsh-agent'
+import type { Context } from '@deepseek-ai/cordis'
+import type { UserMessage } from '@deepseek-ai/dsh-session'
+import { RemoteError, type RemoteInvocation } from '@deepseek-ai/dsh-typert-protocol'
+import type { ModelProviderGroup } from './types.ts'
+
+/** Operations that must authorize the caller independently of input admission. */
+export type TurnProviderControl = 'leave' | 'stop' | 'remove' | 'receipt'
+
+/** Trusted Host contribution for an explicitly selected, text-only turn provider. */
+export interface SessionTurnProvider {
+  /**
+   * Return the group for a live Session and this authenticated invocation, or omit it.
+   * @param agent - exact attached Agent; never activate a Session or contact the provider here.
+   * @param invocation - carrier-supplied caller, absent for direct service use.
+   * @returns the group for the Session, if visible to the caller.
+   */
+  catalog(agent: Agent, invocation: RemoteInvocation | undefined): ModelProviderGroup | undefined
+  /**
+   * Validate an explicit selection without writing it or changing the preset.
+   * @param agent - exact attached Agent.
+   * @param selection - requested route.
+   * @param invocation - carrier-supplied caller.
+   * @returns true only for an authorized choice.
+   */
+  select(agent: Agent, selection: ModelSelection, invocation: RemoteInvocation | undefined): boolean
+  /**
+   * Authorize a native input mutation, then synchronously call accept once within that authority.
+   * @param agent - exact attached Agent.
+   * @param selection - route that would take this occurrence.
+   * @param message - complete identified user input.
+   * @param invocation - carrier-supplied caller.
+   * @param accept - one-use continuation, revoked once this method returns.
+   * @param previous - original queued occurrence for an edit.
+   */
+  withInput(agent: Agent, selection: ModelSelection, message: UserMessage, invocation: RemoteInvocation | undefined,
+    accept: () => void, previous?: UserMessage): void
+  /**
+   * Read one control authorization without mutating the Session.
+   * @param agent - exact attached Agent.
+   * @param action - the native control requested by the caller.
+   * @param invocation - carrier-supplied caller.
+   * @returns whether this control is allowed.
+   */
+  control(agent: Agent, action: TurnProviderControl, invocation: RemoteInvocation | undefined): boolean
+}
+
+/**
+ * Reserved whole-turn provider identity, including when unmounted.
+ * @param provider - current or requested provider.
+ * @returns whether the ordinary adapter must not be used.
+ */
+export function isSessionTurnProvider(provider: string | undefined): boolean {
+  return provider?.startsWith('turn:') === true
+}
+
+/** @returns the native rejection for a missing or unauthorized turn route. */
+export function turnProviderUnavailable(): RemoteError {
+  return new RemoteError('session/agent-busy', 'This turn is not available from this connection.', { reason: 'LOCAL_TURN_UNAVAILABLE' })
+}
+
+/** @returns the native rejection when the composer did not confirm the current selection. */
+export function modelSelectionChanged(): RemoteError {
+  return new RemoteError('session/agent-busy', 'The selected model changed while preparing the draft.', { reason: 'MODEL_SELECTION_CHANGED' })
+}
+
+/** @returns the native rejection before attempting any attachment read or write. */
+export function textOnlySelection(): RemoteError {
+  return new RemoteError('session/attachment-invalid', 'Remove attachments or select a model that accepts them.', { reason: 'TEXT_ONLY_SELECTION' })
+}
+
+/** The Session Controller owns this registration table and its command access. */
+export class SessionTurnProviders {
+  private readonly providers = new Map<string, SessionTurnProvider>()
+
+  /**
+   * Add a provider on the caller's Cordis fiber.
+   * @param owner - context traced to the registering plugin.
+   * @param id - reserved whole-turn route.
+   * @param provider - this Host's admission contribution.
+   * @returns disposer removing this exact contribution.
+   */
+  register(owner: Context, id: string, provider: SessionTurnProvider): () => Promise<void> {
+    if (!/^turn:[a-z0-9][a-z0-9.-]*$/.test(id)) throw new Error('Invalid Session turn provider')
+    return owner.effect(() => {
+      if (this.providers.has(id)) throw new Error(`Session turn provider "${id}" is already registered`)
+      this.providers.set(id, provider)
+      return () => { if (this.providers.get(id) === provider) this.providers.delete(id) }
+    }, `sessionController.registerTurnProvider(${id})`)
+  }
+
+  /**
+   * Find the current contribution for a route.
+   * @param id - provider identity.
+   * @returns the live contribution, if any.
+   */
+  get(id: string): SessionTurnProvider | undefined { return this.providers.get(id) }
+
+  /**
+   * List registered groups visible to one attached Session and its caller.
+   * @param agent - exact live Agent for this catalog inquiry.
+   * @param invocation - carrier-supplied caller.
+   * @returns provider-authored selectable groups, all with the text-only capability.
+   */
+  groups(agent: Agent, invocation: RemoteInvocation | undefined): ModelProviderGroup[] {
+    const groups: ModelProviderGroup[] = []
+    for (const [id, provider] of this.providers) {
+      const group = provider.catalog(agent, invocation)
+      if (group?.id === id && group.models.length > 0 && this.get(id) === provider) groups.push({ ...group, input: 'text-only' })
+    }
+    return groups
+  }
+}
