+/** Registrations for text-only turn execution on the native Session driver. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent, ModelSelection } from '@deepseek-ai/dsh-agent'
+import { LlmError, type FinishReason, type LlmFailure } from '@deepseek-ai/dsh-llm'
+import type { AgentCancelCause, SessionEvent, TurnEndReason, UserMessage } from '@deepseek-ai/dsh-session'
+import { assertNever } from '@deepseek-ai/dsh-util-values'
+
+/** A provider route whose execution is reserved to the turn executor registry. */
+export type TurnExecutorProvider = `turn:${string}`
+
+/** The exact message and selection at an inbox admission point. */
+export type TurnInputAdmission = {
+  readonly agent: Agent
+  readonly selection: Readonly<ModelSelection>
+  readonly message: UserMessage
+} & (
+  | { readonly phase: 'enqueue' | 'claim'; readonly previous?: never }
+  | { readonly phase: 'edit'; readonly previous: UserMessage }
+)
+
+/** One consumed, checkpointed turn. Only the driver can publish its Session events. */
+export interface TurnExecution {
+  readonly agent: Agent
+  readonly selection: Readonly<ModelSelection>
+  readonly turn: number
+  readonly message: UserMessage
+  /** Aborted by native Stop, owner disposal, or executor revocation. */
+  readonly signal: AbortSignal
+  /**
+   * Recheck the live Agent, registration, archive state and cancellation immediately before dispatch, without an intervening await.
+   * @throws when dispatch is no longer authorized or the execution has returned.
+   */
+  assertDispatchable(): void
+  /**
+   * Publish visible assistant text. Calls after the executor's terminal return have no effect.
+   * @param text - a validated output fragment; the provider owns its protocol and size limits.
+   */
+  writeText(text: string): void
+}
+
+/** An observed terminal outcome, or an explicit failure such as unknown delivery. */
+export type TurnExecutorResult =
+  | { readonly kind: 'completed' | 'max-tokens' | 'cancelled' }
+  | { readonly kind: 'error'; readonly error: LlmFailure }
+
+/** A trusted Host contribution; it owns authorization, external delivery and process cleanup. */
+export interface TurnExecutor {
+  /**
+   * Synchronously authorize the exact occurrence; do not mutate the Agent or start I/O.
+   * @param input - queued input, its edit, or its proposed claim. Source fields alone are not authority.
+   * @returns true to admit this occurrence at this point.
+   */
+  authorize(input: TurnInputAdmission): boolean
+  /**
+   * Run once after native input is durable. Recheck before sending and await terminal delivery or confirmed loss of contact.
+   * A thrown abort is local; report external cancellation only after a known terminal acknowledgement.
+   * @param input - the driver's execution capabilities; do not open, claim, or append turn events yourself.
+   * @returns the terminal outcome; return an error for unknown delivery. The driver does not retry.
+   */
+  run(input: TurnExecution): Promise<TurnExecutorResult>
+  /**
+   * Commit provider bookkeeping for a known terminal result after the exact native end is durable.
+   * @param input - the execution whose terminal result was recorded.
+   * @param end - the committed native end event.
+   */
+  afterCommit?(input: TurnExecution, end: SessionEvent<'turn/end'>): Promise<void>
+  /**
+   * Await cleanup of any execution resources, including on failure. Do not await disposal of your own registration here.
+   * @param input - the execution being released.
+   */
+  release?(input: TurnExecution): Promise<void>
+}
+
+/**
+ * Distinguish reserved turn routes even when their executor is absent.
+ * @param selection - the Session's current model selection.
+ * @returns whether the selection belongs exclusively to a turn executor.
+ */
+export function isTurnExecutorSelection(
+  selection: Readonly<ModelSelection> | undefined,
+): selection is Readonly<ModelSelection> & { provider: TurnExecutorProvider } {
+  return selection !== undefined && selection.provider.startsWith('turn:')
+}
+
+/**
+ * Keep an explicit effort distinct from the provider default on queued occurrences.
+ * @param left - the current or previous choice.
+ * @param right - the full expected choice.
+ * @returns whether the choices agree.
+ */
+export function sameTurnSelection(left: Readonly<ModelSelection> | undefined, right: Readonly<ModelSelection>): boolean {
+  return left?.provider === right.provider && left.model === right.model && left.reasoningEffort === right.reasoningEffort
+}
+
+/**
+ * Record a safe, non-retryable turn failure in the existing native error format.
+ * @param code - stable turn-specific failure code.
+ * @param message - user-facing reason.
+ * @returns a coded error with native failure facts.
+ */
+export function turnExecutorError(code: string, message: string): LlmError {
+  return LlmError.fromFailure({ code, message })
+}
+
+/**
+ * Translate a provider's terminal result to the native turn and stream facts.
+ * @param result - the observed external result.
+ * @param cause - copied native cancellation cause, when requested.
+ * @returns the native reason and assistant finish; a returned terminal result wins over a racing Stop.
+ */
+export function turnExecutorOutcome(result: TurnExecutorResult, cause: AgentCancelCause | undefined): {
+  readonly reason: TurnEndReason
+  readonly finish: FinishReason
+} {
+  switch (result.kind) {
+    case 'completed': return { reason: { kind: 'completed' }, finish: { kind: 'stop' } }
+    case 'max-tokens': return { reason: { kind: 'max-tokens' }, finish: { kind: 'max-tokens' } }
+    case 'cancelled': return {
+      reason: { kind: 'aborted', reason: cause ?? { kind: 'legacy' } },
+      finish: { kind: 'aborted', failure: { code: 'ABORTED', message: 'The turn was cancelled.' } },
+    }
+    case 'error': return { reason: { kind: 'error', error: result.error }, finish: { kind: 'error', failure: result.error } }
+    default: return assertNever(result)
+  }
+}
+
+/** One registration generation, with jobs retained through durable end and cleanup. */
+export class TurnExecutorRegistration {
+  private active = true
+  private readonly jobs = new Map<() => void, Promise<void>>()
+
+  constructor(readonly executor: TurnExecutor) {}
+
+  /** Whether this generation can take work or permit a dispatch. */
+  get available(): boolean { return this.active }
+
+  /**
+   * Retain one admitted job until it closes. The caller releases it exactly once in a finally block.
+   * @param stop - cancels this job through the native turn's abort controller.
+   * @returns the release function, or undefined when the generation has been revoked.
+   */
+  retain(stop: () => void): (() => void) | undefined {
+    if (!this.active) return undefined
+    const completion = Promise.withResolvers<void>()
+    this.jobs.set(stop, completion.promise)
+    return () => {
+      this.jobs.delete(stop)
+      completion.resolve()
+    }
+  }
+
+  /** Stop admitted jobs and wait for their cleanup before the provider fiber can unload. */
+  async revoke(): Promise<void> {
+    this.active = false
+    const jobs = [...this.jobs]
+    for (const [stop] of jobs) stop()
+    await Promise.all(jobs.map(([, done]) => done))
+  }
+}
+
+/** AgentLoop-owned registrations, keyed by reserved provider route. */
+export class TurnExecutorRegistry {
+  private readonly providers = new Map<TurnExecutorProvider, TurnExecutorRegistration>()
+
+  /**
+   * Add one provider to the calling fiber; prevent a same-id replacement during cleanup.
+   * @param ctx - the registering plugin's Context.
+   * @param provider - reserved, stable provider route.
+   * @param executor - lifecycle implementation.
+   * @returns a disposer that drains admitted executions.
+   */
+  register(ctx: Context, provider: TurnExecutorProvider, executor: TurnExecutor): () => Promise<void> {
+    if (!/^turn:[a-z0-9][a-z0-9.-]*$/u.test(provider)) throw new TypeError('Invalid turn executor provider')
+    return ctx.effect(() => {
+      if (this.providers.has(provider)) throw turnExecutorError('DUPLICATE_TURN_EXECUTOR', `Turn executor "${provider}" is already registered.`)
+      const registration = new TurnExecutorRegistration(executor)
+      this.providers.set(provider, registration)
+      return async () => {
+        await registration.revoke()
+        this.providers.delete(provider)
+      }
+    }, `agentLoop.registerTurnExecutor(${provider})`)
+  }
+
+  /**
+   * Capture one live generation before the driver publishes its turn start.
+   * @param provider - the selected reserved route.
+   * @returns the live registration, or undefined for absent and revoking providers.
+   */
+  get(provider: TurnExecutorProvider): TurnExecutorRegistration | undefined {
+    const candidate = this.providers.get(provider)
+    return candidate?.available === true ? candidate : undefined
+  }
+}
