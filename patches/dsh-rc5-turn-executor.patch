+
+it('rejects an in-memory Session even with a session/flush listener', async () => {
+  const { ctx, agent, adapter } = await harness({ persistent: false })
+  const observed = observeEvents(ctx, agent)
+  ctx.on('session/flush', () => {})
+  const run = vi.fn<TurnExecutor['run']>(async () => ({ kind: 'completed' }))
+  await mountExecutor(ctx, { authorize: () => true, run })
