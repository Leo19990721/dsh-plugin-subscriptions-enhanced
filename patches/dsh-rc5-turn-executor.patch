new file mode 100644
index 0000000..ea99c6f
--- /dev/null
+++ b/packages/api/session-controller/tests/turn-executor-queue.host.spec.ts
@@ -0,0 +1,133 @@
+/** Queue promotion through the stock Session Remote and the native Agent inbox. */
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { createUserMessage, type MessageId } from '@deepseek-ai/dsh-llm'
+import { SessionId, type SessionEvent } from '@deepseek-ai/dsh-session'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import { expect, it, onTestFinished } from 'vitest'
+import { MockAdapter, textResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { createSessionTestRemote } from './test-remote.ts'
+
+const ORDINARY = { provider: 'mock', model: 'mock' }
+const EXTERNAL = { provider: 'turn:synthetic', model: 'synthetic' } as const
+
+function prompt(text: string) {
+  return createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } })
+}
+
+async function setup(selection: typeof ORDINARY, adapter: MockAdapter) {
+  const ctx = new Context()
+  const root = await mkdtemp(join(tmpdir(), 'dsh-turn-executor-queue-'))
+  const entered = Promise.withResolvers<undefined>()
+  const resume = Promise.withResolvers<undefined>()
+  const release = () => { resume.resolve(undefined) }
+  onTestFinished(async () => {
+    release()
+    try { await ctx.fiber.dispose() } finally {
+      await rm(root, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 })
+    }
+  })
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  await ctx.plugin(AgentLoop, { agents: [] })
+  ctx.effect(() => ctx.llm.registerAdapter([ORDINARY.provider], adapter))
+  const remote = await createSessionTestRemote(ctx, { defaultModelSelection: () => ORDINARY, cwd: root })
+  const agent = await ctx.agentLoop.create(SessionId('queue-promotion'), selection)
+  const events: SessionEvent[] = []
+  ctx.on('session/event', (session, event) => { if (session === agent.session) events.push(event) })
+
+  return {
+    ctx, agent, events, release,
+    promote: (itemId: MessageId) => remote.updateQueue({ sessionId: agent.id, itemId, action: { kind: 'steer' } }),
+    async hold() {
+      entered.resolve(undefined)
+      await resume.promise
+    },
+    async waitForHold() {
+      await Promise.race([entered.promise, agent.whenIdle().then(() => {
+        throw new Error('The Agent settled before the first step reached its barrier')
+      })])
+    },
+  }
+}
+
+it('rejects steering a queued occurrence during an external turn without changing the inbox', async () => {
+  const adapter = new MockAdapter([])
+  const { ctx, agent, events, hold, release, waitForHold, promote } = await setup(EXTERNAL, adapter)
+  const active = prompt('hold this external turn')
+  const first = prompt('first followup')
+  const second = prompt('second followup')
+  const seen: { id: MessageId; turn: number }[] = []
+  await ctx.plugin({
+    inject: ['agentLoop'],
+    apply(owner: Context) {
+      owner.agentLoop.registerTurnExecutor(EXTERNAL.provider, {
+        authorize: () => true,
+        async run(input) {
+          input.assertDispatchable()
+          seen.push({ id: input.message.id, turn: input.turn })
+          if (input.message.id === active.id) await hold()
+          input.writeText('external reply')
+          return { kind: 'completed' }
+        },
+      })
+    },
+  })
+
+  agent.followup(active)
+  await waitForHold()
+  agent.followup(first)
+  agent.followup(second)
+  expect(agent.inbox.nextTurn.map(item => item.id)).toEqual([first.id, second.id])
+  const beforeSteer = events.length
+  await expect(promote(second.id)).resolves.toMatchObject({
+    ok: false, error: { code: 'session/steer-unavailable', details: { itemId: second.id } },
+  })
+  expect(agent.inbox.nextTurn.map(item => item.id)).toEqual([first.id, second.id])
+  expect(agent.inbox.nextStep).toEqual([])
+  expect(events.slice(beforeSteer)).toEqual([])
+  release()
+  await agent.whenIdle()
+
+  expect(seen).toEqual([{ id: active.id, turn: 1 }, { id: first.id, turn: 2 }, { id: second.id, turn: 3 }])
+  expect(agent.inbox.nextTurn).toEqual([])
+  expect(adapter.requests).toHaveLength(0)
+  await using reader = await ctx.sessionPersistence.open(agent.id, 'read')
+  const { events: stored } = await reader.read()
+  expect(stored.filter(event => event.type === 'user/message').map(event => event.data.id)).toEqual([active.id, first.id, second.id])
+  expect(stored.filter(event => event.type === 'agent/inbox/spliced' && event.data.outcome === 'canceled')).toEqual([])
+  expect(stored.filter(event => event.type === 'turn/end').map(event => event.data.reason.kind))
+    .toEqual(['completed', 'completed', 'completed'])
+})
+
+it('promotes a queued occurrence into the next step of an ordinary running turn', async () => {
+  const adapter = new MockAdapter([textResponse('ordinary reply'), textResponse('steered reply')])
+  const { ctx, agent, events, hold, release, waitForHold, promote } = await setup(ORDINARY, adapter)
+  const active = prompt('hold the ordinary pre-step')
+  const queued = prompt('steer this occurrence')
+  ctx.on('agent/pre-step', async ({ agent: subject, step }, next) => {
+    if (subject === agent && step === 1) await hold()
+    return next()
+  })
+
+  agent.followup(active)
+  await waitForHold()
+  agent.followup(queued)
+  await expect(promote(queued.id)).resolves.toEqual({ ok: true, value: { accepted: true } })
+  expect(agent.inbox.nextTurn).toEqual([])
+  expect(agent.inbox.nextStep.map(item => item.id)).toEqual([queued.id])
+  release()
+  await agent.whenIdle()
+
+  expect(agent.inbox.nextStep).toEqual([])
+  expect(adapter.requests).toHaveLength(2)
+  expect(adapter.requests[1]?.messages.filter(item => item.role === 'user').map(item => item.content))
+    .toEqual([active.content, queued.content])
+  expect(events.filter(event => event.type === 'user/message').map(event => event.data.id)).toEqual([active.id, queued.id])
+  expect(events.filter(event => event.type === 'step/start').map(event => event.data)).toEqual([{ turn: 1, step: 1 }, { turn: 1, step: 2 }])
+  expect(events.filter(event => event.type === 'turn/end').map(event => event.data)).toEqual([{ turn: 1, reason: { kind: 'completed' } }])
+})
