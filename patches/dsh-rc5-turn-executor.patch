+  const { ctx, agent, adapter, gate, storedEvents } = await harness()
+  const prompt = message('stop before dispatch')
+  const observed = observeEvents(ctx, agent)
+  const flushing = gate()
+  ctx.on('session/flush', (session) => {
+    if (session === agent.session && userIds(observed).includes(prompt.id) && observed.at(-1)?.type !== 'turn/end') {
+      return flushing.hold(undefined)
+    }
+  })
+  const run = vi.fn<TurnExecutor['run']>(async () => ({ kind: 'completed' }))
+  const afterCommit = vi.fn(async () => {})
+  await mountExecutor(ctx, { authorize: () => true, run, afterCommit })
+  agent.followup(prompt)
+  await duringWork(agent, flushing.entered)
+  agent.cancel({ kind: 'user' }, { keepInbox: true })
+  flushing.open()
+  await agent.whenIdle()
+
+  const events = await storedEvents()
+  expect(userIds(events)).toEqual([prompt.id])
+  expect(turnEnds(events)).toEqual([{ turn: 1, reason: { kind: 'aborted', reason: { kind: 'user' } } }])
