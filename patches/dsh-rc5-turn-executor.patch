+function message(text: string) {
+  return createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } })
+}
+
+async function harness({
+  selection = SYNTHETIC, adapter = new MockAdapter([textResponse('ordinary reply')]), persistent = true, resume,
+}: {
+  selection?: ModelSelection
+  adapter?: MockAdapter
+  persistent?: boolean
+  resume?: { header: SessionHeader; events: readonly SessionEvent[] }
+} = {}) {
+  const ctx = new Context()
+  const root = persistent ? await mkdtemp(join(tmpdir(), 'dsh-turn-executor-')) : undefined
+  const unblocks: (() => void)[] = []
+  onTestFinished(async () => {
+    for (const unblock of unblocks) unblock()
+    try {
+      await ctx.fiber.dispose()
+    } finally {
+      if (root !== undefined) await rm(root, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 })
+    }
+  })
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(Tools)
+  await ctx.plugin(NativeToolExecutor)
+  await ctx.plugin(AgentRegistry)
+  if (root !== undefined) await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  await ctx.plugin(AgentLoop, { agents: [] })
+  ctx.llm.registerAdapter([ORDINARY.provider], adapter)
+  async function restore({ header, events }: NonNullable<typeof resume>) {
+    {
+      await using writer = await ctx.sessionPersistence.create(header)
+      await writer.append(events)
+    }
+    return ctx.agents.resume({ resumeSessionId: header.id, agentOptions: ORDINARY })
+  }
+  const { agent } = resume === undefined
+    ? await ctx.agents.create({ sessionId: SessionId('turn-spec'), agentOptions: selection })
+    : await restore(resume)
+
+  function gate<T = undefined>() {
+    const entered = Promise.withResolvers<T>()
+    const proceed = Promise.withResolvers<undefined>()
+    const open = () => { proceed.resolve(undefined) }
+    unblocks.push(open)
+    return {
+      entered: entered.promise,
+      open,
+      async hold(value: T, signal?: AbortSignal): Promise<void> {
+        entered.resolve(value)
+        if (signal?.aborted) return
+        signal?.addEventListener('abort', open, { once: true })
+        try {
+          await proceed.promise
+        } finally {
+          signal?.removeEventListener('abort', open)
+        }
+      },
+    }
+  }
+
+  const storedEvents = async (): Promise<readonly SessionEvent[]> => {
+    await using reader = await ctx.sessionPersistence.open(agent.id, 'read')
+    return (await reader.read()).events
+  }
+  return { ctx, agent, adapter, gate, storedEvents }
+}
+
+function mountExecutor(ctx: Context, executor: TurnExecutor) {
+  return ctx.plugin({
+    inject: ['agentLoop'],
+    apply(owner: Context) { owner.agentLoop.registerTurnExecutor(SYNTHETIC.provider, executor) },
+  }).await()
+}
+
+function turnEnds(events: readonly SessionEvent[]) {
+  return events.filter(event => event.type === 'turn/end').map(event => event.data)
+}
+
+function userIds(events: readonly SessionEvent[]) {
+  return events.filter(event => event.type === 'user/message').map(event => event.data.id)
+}
+
+function observeEvents(ctx: Context, agent: Agent): SessionEvent[] {
+  const events: SessionEvent[] = []
+  ctx.on('session/event', (session, event) => { if (session === agent.session) events.push(event) })
+  return events
+}
