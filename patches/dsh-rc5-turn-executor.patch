+  expect(() => agent.followup(message('no writer'))).toThrow(expect.objectContaining({ code: 'TURN_REQUIRES_PERSISTENCE' }))
+  expect(agent.inbox.nextTurn).toEqual([])
+  expect(observed).toEqual([])
+  expect(run).not.toHaveBeenCalled()
+  expect(adapter.requests).toEqual([])
+})
+
+it('aborts on provider fiber disposal and waits for release before removing the route', async () => {
+  const { ctx, agent, adapter, gate, storedEvents } = await harness()
+  ctx.llm.registerAdapter([SYNTHETIC.provider], adapter)
+  const running = gate<TurnExecution>()
+  const releasing = gate<TurnExecution>()
+  const order: string[] = []
+  const lateDispatch = vi.fn()
+  const deniedDispatch = vi.fn()
+  const run = vi.fn<TurnExecutor['run']>(async (input) => {
+    input.assertDispatchable()
+    await running.hold(input, input.signal)
+    try {
+      input.assertDispatchable()
+    } catch (error: unknown) {
+      deniedDispatch(error)
+      return { kind: 'cancelled' }
+    }
+    lateDispatch()
+    return { kind: 'cancelled' }
+  })
+  const owner = await mountExecutor(ctx, {
+    authorize: () => true,
+    run,
+    async release(input) {
+      order.push('release started')
+      await releasing.hold(input)
+      order.push('release finished')
+    },
+  })
+
+  agent.followup(message('unmount while running'))
+  const input = await duringWork(agent, running.entered)
+  const disposing = owner.dispose().then(() => { order.push('disposed') })
+  try {
+    const releaseInput = await duringWork(agent, releasing.entered)
+    expect(input.signal.aborted).toBe(true)
+    expect(releaseInput === input).toBe(true)
+    expect(deniedDispatch).toHaveBeenCalledTimes(1)
+    expect(lateDispatch).not.toHaveBeenCalled()
+    expect(turnEnds(await storedEvents())).toMatchObject([{ turn: 1, reason: { kind: 'aborted' } }])
+    expect(order).toEqual(['release started'])
+  } finally {
+    releasing.open()
+    await disposing
+  }
+  await agent.whenIdle()
+  expect(order).toEqual(['release started', 'release finished', 'disposed'])
+  expect(ctx.agents.get(agent.id) === agent).toBe(true)
+
+  expect(() => agent.followup(message('do not fall back'))).toThrow(expect.objectContaining({ code: 'TURN_EXECUTOR_UNAVAILABLE' }))
+  await agent.whenIdle()
+  expect(run).toHaveBeenCalledTimes(1)
+  expect(adapter.requests).toEqual([])
+  expect(turnEnds(await storedEvents())).toHaveLength(1)
+})
